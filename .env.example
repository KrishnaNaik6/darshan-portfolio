# =====================================================================
# Darshan Portfolio — Environment Variables Configuration Template
# =====================================================================
# Copy this file to .env.local for local development, or add these
# keys in your Vercel Dashboard -> Project Settings -> Environment Variables.

# ---------------------------------------------------------------------
# 1. Admin Authentication (Dashboard Portal at /admin)
# ---------------------------------------------------------------------
ADMIN_USERNAME=darshan_admin
ADMIN_PASSWORD=darshan@editor2026
AUTH_SECRET=darshan-portfolio-ultra-secure-key-change-this-in-production-2026

# ---------------------------------------------------------------------
# 2. Site URL (For Canonical Links, XML Sitemap, and SEO Rich Snippets)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://darshan-poojari.vercel.app

# ---------------------------------------------------------------------
# 3. Supabase Cloud Database (For Persistent Storage on Vercel)
# ---------------------------------------------------------------------
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Optional: Service role key for admin-level bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
